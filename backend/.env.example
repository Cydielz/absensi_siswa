# Salin menjadi .env. Nilai kosong untuk rahasia akan DIISI OTOMATIS saat server pertama kali dijalankan
# (password admin & API key akan ditampilkan sekali di jendela server).

# --- Server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# WIB = Asia/Jakarta, WITA = Asia/Makassar, WIT = Asia/Jayapura
TIMEZONE=Asia/Jakarta

# --- Rahasia (dibuat otomatis bila kosong) ---
FLASK_SECRET_KEY=
QR_SECRET=
SCAN_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- WhatsApp (Fonnte) ---
FONNTE_TOKEN=
FONNTE_COUNTRY_CODE=62

# --- Opsional ---
# 1 = terima QR lama berisi NISN polos (TIDAK disarankan; hanya untuk masa transisi)
ALLOW_LEGACY_NISN=0
# 1 bila diakses lewat HTTPS
SESSION_COOKIE_SECURE=0
